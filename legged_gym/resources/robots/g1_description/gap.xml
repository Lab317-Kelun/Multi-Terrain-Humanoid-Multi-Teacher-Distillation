<mujoco model="g1_23dof gap scene">
  <compiler angle="radian" />
  
  <include file="g1.xml" />

  <statistic center="10 0 0.8" extent="20.0" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <texture type="2d" name="platform" builtin="checker" rgb1="0.4 0.4 0.4" rgb2="0.3 0.3 0.3" width="300" height="300" />
    <material name="platform" texture="platform" texuniform="true" texrepeat="3 3" reflectance="0.1" />
  </asset>

  <worldbody>
    <light pos="10 0 3" dir="0 0 -1" directional="true" />
    <!-- 地面（低于高台0.3m） -->
    <geom name="floor" pos="0 0 -0.3" size="0 0 0.05" type="plane" material="groundplane" />
    
    <!-- 高台序列：每个高台3×3m，间隙0.2m，高度0.3m -->
    <!-- 第一个高台：机器人出生位置 (x=0到3) -->
    <geom name="platform_1" pos="1.5 0 0" type="box" size="1.5 1.5 0.3" material="platform" />
    
    <!-- 第二个高台 (x=3.2到6.2) -->
    <geom name="platform_2" pos="4.7 0 0" type="box" size="1.5 1.5 0.3" material="platform" />
    
    <!-- 第三个高台 (x=6.4到9.4) -->
    <geom name="platform_3" pos="7.9 0 0" type="box" size="1.5 1.5 0.3" material="platform" />
    
    <!-- 第四个高台 (x=9.6到12.6) -->
    <geom name="platform_4" pos="11.1 0 0" type="box" size="1.5 1.5 0.3" material="platform" />
    
    <!-- 第五个高台 (x=12.8到15.8) -->
    <geom name="platform_5" pos="14.3 0 0" type="box" size="1.5 1.5 0.3" material="platform" />
  </worldbody>
</mujoco>