/**
 * 手臂动作 LCM 消息定义
 * 通道："arm_action"
 * 发布者：Python 程序（可选，当前未使用）
 * 订阅者：C++ 程序 (g1_control.cpp)
 * 
 * 功能：发送手臂关节目标位置给 C++ 控制程序
 * 
 * C++ 处理逻辑（g1_control.cpp 第532-538行）：
 * - 索引 0-13（14个关节）：对应 C++ 的索引 15-28（左臂7个 + 右臂7个）
 * - 如果 Python 不发送此消息，C++ 使用默认值 0
 */
struct arm_action_lcmt
{
    double act[14];            // 手臂关节目标位置（单位：弧度）
                               // 索引 0-6：左臂（肩部3 + 肘部1 + 腕部3）
                               // 索引 7-13：右臂（肩部3 + 肘部1 + 腕部3）
}
